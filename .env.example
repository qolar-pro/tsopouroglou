# Copy to .env.local (gitignored) — never commit real values.

# Overrides SITE_URL. Set this only if you need to force an origin; production
# uses the domain in src/content/site-config.ts and previews use their own
# deployment URL automatically.
#
# LEAVE IT UNSET RATHER THAN BLANK. An empty value used to break the build.
NEXT_PUBLIC_SITE_URL=
