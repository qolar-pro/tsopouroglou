# Copy to .env.local (gitignored) — never commit real values.

# Resend API key. Without it the form returns 503 "not-configured" and the
# UI tells the visitor to phone instead.
RESEND_API_KEY=

# Sender. The real domain isn't registered yet, so the pipeline runs on a
# temporary verified sender. Swap when the .gr is live and verified in Resend.
RESEND_FROM="Ιστοσελίδα <noreply@blancographics.xyz>"

# Where quote requests land. Override for testing.
RESEND_TO=gregorestsopouroglou@gmail.com

# Overrides SITE_URL — for Vercel previews. Production uses the default in
# src/content/site-config.ts.
NEXT_PUBLIC_SITE_URL=
